  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "db:migrate": "docker compose exec backend npx prisma migrate dev",
    "db:reset": "docker compose exec backend npx prisma migrate reset --force",
    "db:generate": "docker compose exec backend npx prisma generate",
    "db:studio": "docker compose exec backend npx prisma studio",
    "test": "jest",
    "test:auth": "jest tests/auth/",
    "test:auth:basic": "jest tests/auth/auth.service.basic.spec.ts",
    "test:auth:integration": "jest tests/auth/auth.service.integration.spec.ts",
    "test:auth:unit": "jest tests/auth/auth.service.spec.ts",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:all": "jest tests/ --coverage --verbose"
  },
